generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ATTORNEY
  ADMIN
}

enum VendorType {
  ATTORNEY
  MARKETING_SPECIALIST
}

model User {
  id                      String             @id @default(uuid())
  email                   String             @unique
  password_hash           String
  role                    Role               @default(USER)
  full_name               String?
  phone                   String?
  firm_name               String?
  specialties             String?
  bar_number              String?
  years_experience        Int?               @default(0)
  city                    String?
  country                 String?
  emergency_contact_name  String?
  emergency_contact_phone String?
  membership_tier         String             @default("basic")
  seen_notification_ids   String[]           @default([])
  stripe_customer_id      String?          @unique
  stripe_subscription_id  String?          @unique
  subscription_cancel_at  DateTime?
  
  created_at              DateTime           @default(now())
  updated_at              DateTime           @updatedAt

  encounter_sessions      EncounterSession[]
  civil_intakes           CivilIntake[]      @relation("UserIntakes")
  assigned_intakes        CivilIntake[]      @relation("AttorneyIntakes")
  assigned_encounters     EncounterSession[] @relation("AttorneyEncounters")
  emergency_alerts        EmergencyAlert[]
  sent_messages           ChatMessage[]      @relation("SentMessages")
  received_messages       ChatMessage[]      @relation("ReceivedMessages")
  sent_calls             CallLog[]          @relation("SentCalls")
  received_calls         CallLog[]          @relation("ReceivedCalls")

  @@index([role])
}

model EncounterSession {
  id               String           @id @default(uuid())
  user_id          String
  user             User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  encounter_type   String
  status           String           @default("active")
  location_lat     Float?
  location_lng     Float?
  location_address String?
  notes            String?
  attorney_name    String?
  recording_url    String?
  recorded_by_id   String?
  egress_id        String?
  recording_started_at DateTime?
  recording_ended_at   DateTime?
  emergency_contact_phone String?
  rejection_message String?
  started_at       DateTime         @default(now())
  ended_at         DateTime?
  created_at       DateTime         @default(now())

  assigned_attorney_id String?
  assigned_attorney    User?    @relation("AttorneyEncounters", fields: [assigned_attorney_id], references: [id])

  emergency_alerts EmergencyAlert[]

  @@index([user_id])
  @@index([status])
  @@index([assigned_attorney_id])
}

model CivilIntake {
  id                String   @id @default(uuid())
  user_id           String
  user              User     @relation("UserIntakes", fields: [user_id], references: [id], onDelete: Cascade)
  matter_type       String
  urgency           String   @default("standard")
  subject           String
  description       String
  preferred_contact String   @default("phone")
  status            String   @default("pending") // "pending", "assigned", "active", "resolved", "rejected", "reassign"
  opposing_party          String?
  opposing_party_location String?
  
  assigned_attorney_id String?
  assigned_attorney    User?    @relation("AttorneyIntakes", fields: [assigned_attorney_id], references: [id])
  
  rejection_message String?
  metadata          Json?
  
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@index([user_id])
  @@index([status])
  @@index([assigned_attorney_id])
}

model ChatMessage {
  id            String   @id @default(uuid())
  content       String
  sender_id     String
  sender        User     @relation("SentMessages", fields: [sender_id], references: [id], onDelete: Cascade)
  
  receiver_id   String
  receiver      User     @relation("ReceivedMessages", fields: [receiver_id], references: [id], onDelete: Cascade)

  is_read       Boolean  @default(false)
  created_at    DateTime @default(now())

  @@index([sender_id])
  @@index([receiver_id])
}

model EmergencyAlert {
  id            String            @id @default(uuid())
  session_id    String?            @unique
  session       EncounterSession? @relation(fields: [session_id], references: [id], onDelete: Cascade)
  user_id       String
  user          User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  contact_name  String?
  contact_phone String?
  message       String?
  sent_at       DateTime          @default(now())

  @@index([user_id])
  @@index([session_id])
}

model VendorApplication {
  id               String   @id @default(uuid())
  vendor_type      VendorType
  full_name        String
  firm_name        String?
  email            String   @unique
  phone            String?
  location         String?
  city             String?
  country          String?
  website          String?
  specialties      String?
  bar_number       String?
  years_experience Int?     @default(0)
  message          String?
  rejection_message String?
  status           String   @default("pending")
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([status])
}

model Otp {
  id         String   @id @default(uuid())
  email      String
  otp_hash   String
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([email])
}

model ContactMessage {
  id         String   @id @default(uuid())
  name       String
  email      String
  message    String
  hasReplied Boolean  @default(false)
  status     String   @default("unread") // "unread", "read", "archived"
  created_at DateTime @default(now())

  @@index([status])
}

model CallLog {
  id           String   @id @default(uuid())
  room         String
  caller_id    String
  receiver_id  String
  call_type    String   @default("video") // "video" or "audio"
  status       String   @default("initiated") // "initiated", "answered", "declined", "missed", "ended"
  started_at   DateTime @default(now())
  ended_at     DateTime?
  recording_started_at DateTime?
  recording_ended_at   DateTime?
  egress_id    String?
  recording_url String?
  recorded_by_id String?
  
  caller       User     @relation("SentCalls", fields: [caller_id], references: [id], onDelete: Cascade)
  receiver     User     @relation("ReceivedCalls", fields: [receiver_id], references: [id], onDelete: Cascade)

  @@index([caller_id])
  @@index([receiver_id])
  @@index([room])
}
